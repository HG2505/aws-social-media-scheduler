# Server Settings
PORT=8000
ENVIRONMENT=development

# Database Settings (SQLite local for dev, PostgreSQL RDS for prod)
DATABASE_URL=sqlite:///./posts_scheduler.db

# AWS Credentials (For S3 and EventBridge Scheduler)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your-social-media-posts-bucket
AWS_EVENTBRIDGE_SCHEDULER_ROLE_ARN=arn:aws:iam::123456789012:role/EventBridgeSchedulerRole

# ==============================================================================
# AI Provider Options (Chỉ cần điền 1 trong các mục dưới đây)
# ==============================================================================
# Tùy chọn 1: Google Gemini (Miễn phí từ aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# Tùy chọn 2: Groq (Miễn phí, siêu nhanh từ console.groq.com - Llama 3.3)
GROQ_API_KEY=your_groq_api_key

# Tùy chọn 3: DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key

# Tùy chọn 4: OpenAI
OPENAI_API_KEY=your_openai_api_key

# Tùy chọn 5: AWS Bedrock (Claude 3.5 Sonnet / Llama 3)
# Đặt AI_PROVIDER=bedrock để sử dụng chính AWS Bedrock với quyền IAM hiện tại
AI_PROVIDER=auto
